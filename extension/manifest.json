{
  "manifest_version": 3,
  "name": "AI korektura",
  "version": "0.1.0",
  "description": "Česká AI korektura článků přímo v CMS: přihlášení e-mailem, návrhy oprav, schválení a vložení zpět do editoru.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://cms.echomedia.cz/*",
    "https://news-view.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://cms.echomedia.cz/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["https://cms.echomedia.cz/*"]
    }
  ]
}
