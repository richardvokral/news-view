# Redis (standard Redis URL - works with Vercel Redis integration)
STORAGE_REDIS_REDIS_URL=

# PostgreSQL (Neon serverless - for long-term article storage, ACL, dashboard layouts)
DATABASE_URL=

# Upstash QStash (for 15-min scheduling on Vercel Hobby plan)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# News APIs (also configurable via /admin/settings)
WORLDNEWSAPI_KEY=
NEWSDATAHUB_KEY=
GNEWS_KEY=
TWITTER_BEARER_TOKEN=

# AI Clustering (also configurable via /admin/settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Cron security
CRON_SECRET=

# Logto (OIDC auth)
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=
LOGTO_BASE_URL=

# Access control: semicolon-separated admin emails (bypass DB ACL, never stored in DB)
# Example: ADMIN_EMAILS=you@example.com;coworker@example.com
ADMIN_EMAILS=

# Plausible analytics (same instance, potentially multiple sites)
PLAUSIBLE_API_URL=
PLAUSIBLE_API_KEY=
# Semicolon-separated list of site IDs, e.g. echo24.cz;hrot24.cz
PLAUSIBLE_SITE_IDS=
# Optional: site ID → browsable base URL overrides (default is https://<siteId>)
# Example: PLAUSIBLE_SITE_BASEURLS=echo24.cz=https://www.echo24.cz
PLAUSIBLE_SITE_BASEURLS=

# Optional: scrape.do token — fallback proxy for the Google Trends sidebar
# when the direct trends.google.com RSS fetch is geo-blocked
SCRAPE_DO_TOKEN=

# Optional: USD→CZK rate for proofread cost display (default 23)
USD_TO_CZK=
